# Kopieer dit bestand naar .env en vul in. .env staat in .gitignore.

# Earth Engine Cloud-project (verplicht)
EE_PROJECT=my-project-brokopondo

# Pas later in stap 8 (service account) in te vullen — leeg laten voor
# interactieve authenticatie via `earthengine authenticate` / ee.Authenticate().
# In GitHub Actions komt de sleutel via het secret EE_PRIVATE_KEY_DATA
# (JSON-inhoud) in plaats van een bestandspad.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_FILE=
EE_PRIVATE_KEY_DATA=

# Pad naar de bestaande ERA5-Land Heat Index klimatologie (NetCDF).
# Zolang dit leeg is of het bestand ontbreekt, draait de pipeline
# ZONDER biascorrectie en wordt daarvoor een waarschuwing gelogd.
ERA5_CLIMATOLOGY_FILE=
